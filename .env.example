# Grok (xAI) — obligatorio para el modo real. GROK_MODEL: extraccion y reporte
XAI_API_KEY=xai-...
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.3        # o grok-4.5

# Juez: Grok SIN razonamiento + votacion (xAI no expone logprobs)
JUEZ_MODEL=grok-4.20-0309-non-reasoning
JUEZ_MUESTRAS=5
JUEZ_TEMPERATURA=1.0

# Reglas del negocio
HORIZONTE_DIAS=7
STOCK_SEGURIDAD=0.15
UMBRAL_CONFIANZA=0.70
CALIDAD_MINIMA=B
